@page
@model KCalller.Pages.CreateProductModel
@{
}

<div>
    <h1 class="display-4">Create Product</h1>
    <form method="post" class="card p-4 shadow-sm">
        <div class="mb-3">
            <label class="form-label fw-bold">Name</label>
            <input asp-for="ProductInput.Name" class="form-control" type="text" placeholder="z.B. Toastbrot" required/>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Kalorien pro 100g</label>
            <input asp-for="ProductInput.CaloriesPer" class="form-control" type="number" min="0" step="0.1" placeholder="260" required/>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Einheit</label>
            <input asp-for="ProductInput.ServingUnit" class="form-control" type="text" placeholder="z.B. Scheibe" required/>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Gewicht pro Einheit</label>
            <input asp-for="ProductInput.ServingWeight" class="form-control" type="number" min="1" step="0.1" placeholder="z.B. 20" required/>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-3">
            <a asp-page="/Index" class="btn btn-outline-secondary">Abbrechen</a>
            <button type="submit" class="btn btn-primary">Speichern</button>
        </div>
    </form>
</div>