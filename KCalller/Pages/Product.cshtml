@page
@model KCalller.Pages.ProductModel
@{
}

<div>
    <h1 class="display-4">Products</h1>
    <a asp-page="/CreateProduct" class="btn btn-primary">Create Product</a>
</div>
@if (!Model.Products.Any())
{
    <div class="alert alert-info shadow-sm">
        Noch keine Produkte vorhanden. Lege deine erstes Produkt an!
    </div>  
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Kalorien (pro 100g)</th>
                        <th>Standard-Portion</th>
                        <th>Gewicht pro Portion</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var item in Model.Products)
                    {
                        <tr>
                            <td class="fw-bold">@item.Name</td>
                            <td>@item.CaloriesPer</td>
                            <td>@item.ServingUnit</td>
                            <td>@item.ServingWeight</td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>

    </div>    
}

